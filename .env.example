# ------------------------------------------------------------------
# AUTORFP Frontend — environment contract
# Copy to `.env.local` (development) / configure per deployment stage.
# Runtime values come from the deployment platform; only the *shape*
# is committed. Never commit real secrets.
#
# Contract source: frontend/technical/api/frontend-api-contract.md §1
# Stage layout:  .env.development / .env.production / .env.test (+ local override)
# ------------------------------------------------------------------

# Public API origin that browsers call through the Next BFF. The BFF
# relays to BACKEND_API_URL server-side. (public)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public canonical origin of this app (used for redirects/canonical URLs). (public)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend origin used ONLY by server-side BFF route handlers. Must not
# be exposed to the browser; never prefix with NEXT_PUBLIC_. (server)
BACKEND_API_URL=http://localhost:8000

# Name of the httpOnly refresh cookie set by the BFF. (server)
SESSION_COOKIE_NAME=__session

# Sentry DSNs. Leave empty to run without error reporting. (public / server)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Feature flags (boolean strings, public)
NEXT_PUBLIC_ENABLE_REGISTRATION=false
NEXT_PUBLIC_ENABLE_SSO=true
