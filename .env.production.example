# Production environment contract for AWS Amplify Hosting.
# Copy values into the Amplify console (App settings -> Environment variables)
# and trigger a new deployment. Do NOT commit real values.

# --- Public (inlined into client bundles at BUILD time) ------------------
# The browser only ever talks same-origin HTTPS: /api/v1/* is rewritten
# server-side by next.config.ts to BACKEND_API_URL. Therefore these must be
# this app's own origin (the Amplify domain).
NEXT_PUBLIC_API_URL=https://main.<your-amplify-subdomain>.amplifyapp.com
NEXT_PUBLIC_APP_URL=https://main.<your-amplify-subdomain>.amplifyapp.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENABLE_REGISTRATION=false
NEXT_PUBLIC_ENABLE_SSO=true

# --- Server-only (never exposed to the browser) -------------------------
# Plain-HTTP backend is fine here because the proxy relays server-side.
BACKEND_API_URL=http://ec2-13-232-216-43.ap-south-1.compute.amazonaws.com:8000
SESSION_COOKIE_NAME=__session
SENTRY_DSN=